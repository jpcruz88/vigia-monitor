# Copia este archivo como .env y rellena los valores. Nunca subas el .env a git.

# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# De tu app en https://www.linkedin.com/developers/apps (pestaña "Auth")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Los rellena automáticamente: python autorizar.py
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=

# Opcional: versión de la API de LinkedIn (AAAAMM)
# LINKEDIN_VERSION=202609
